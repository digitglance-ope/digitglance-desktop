{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DigitGlance Trade",
  "version": "1.0.1",
  "identifier": "com.digitglance.trade",
  "build": {
    "frontendDist": "../dist/trade"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DigitGlance Trade",
        "url": "index.html",
        "width": 1320,
        "height": 880,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "fullscreen": false,
        "decorations": true
      }
    ]
  },
  "bundle": {
    "shortDescription": "Invoicing, sales & stock for Nigerian businesses.",
    "longDescription": "DigitGlance Trade — branded invoicing and payments, a fast retail point of sale, and stock that counts itself, plus the DigitGlance AI assistant. NRS-ready VAT, multi-company support and more, the full DigitGlance Trade product in a dedicated, secure native window.",
    "icon": [
      "icons/trade/32x32.png",
      "icons/trade/128x128.png",
      "icons/trade/128x128@2x.png",
      "icons/trade/icon.icns",
      "icons/trade/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/digitglance-ope/digitglance-desktop/releases/download/trade-latest/latest.json"
      ]
    }
  }
}
