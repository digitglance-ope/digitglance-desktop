{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "local-store",
  "description": "The offline till local store (src/store). Granted ONLY to the bundled till window (label `till`, DigitGlance Trade): with no `remote` section, Tauri refuses these commands to any remote origin, and the `backoffice` window (the web app at https://digitglance.com) is not named here, so web pages can never call them.",
  "windows": [
    "till"
  ],
  "platforms": [
    "windows",
    "macOS",
    "linux"
  ],
  "permissions": [
    "allow-store-open",
    "allow-store-close",
    "allow-device-identity-get",
    "allow-device-identity-save",
    "allow-device-identity-clear",
    "allow-device-secret-get",
    "allow-store-status",
    "allow-storage-check",
    "allow-settings-get",
    "allow-settings-set",
    "allow-catalog-apply-snapshot",
    "allow-catalog-apply-changes",
    "allow-catalog-get-cursor",
    "allow-catalog-search",
    "allow-catalog-by-barcode",
    "allow-catalog-get-products",
    "allow-categories-list",
    "allow-customers-search",
    "allow-customer-get",
    "allow-staff-list",
    "allow-pin-verify",
    "allow-sale-commit",
    "allow-shift-open",
    "allow-shift-close",
    "allow-shift-current",
    "allow-sales-recent",
    "allow-sale-get",
    "allow-queue-next-batch",
    "allow-queue-mark",
    "allow-queue-failed-list",
    "allow-queue-retry-failed",
    "allow-cleanup-run",
    "allow-export-pending",
    "allow-audit-append",
    "allow-audit-take-unsent",
    "allow-audit-mark-sent"
  ]
}
